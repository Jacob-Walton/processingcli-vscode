{
	"name": "processingcli-vscode",
	"version": "0.0.0",
	"publisher": "konpeki",
	"displayName": "ProcessingCLI for VS Code",
	"description": "Run Processing sketches in VS Code with ProcessingCLI. A fork of the Processing Foundation extension with faster, more reliable sketch launching.",
	"author": "Jacob Walton",
	"license": "LGPL-2.1-or-later",
	"repository": {
		"type": "git",
		"url": "https://github.com/Jacob-Walton/processingcli-vscode"
	},
	"categories": [
		"Programming Languages"
	],
	"keywords": [
		"processing",
		"processingOrg",
		"pde",
		"language",
		"lsp",
		"language-server",
		"sketch",
		"arduino",
		"p5js",
		"p5",
		"p5.js",
		"java",
		"development",
		"creative-coding",
		"learning"
	],
	"engines": {
		"vscode": "^1.75.0"
	},
	"activationEvents": [
		"onStartupFinished",
		"workspaceContains:**/*.pde"
	],
	"main": "./client/out/extension",
	"contributes": {
		"commands": [
			{
				"command": "processing.sketch.run",
				"title": "Run the Processing Sketch",
				"icon": "media/start.svg"
			},
			{
				"command": "processing.sketch.restart",
				"title": "Restart the Processing Sketch",
				"icon": "media/restart.svg"
			},
			{
				"command": "processing.sketch.stop",
				"title": "Stop the Processing Sketch",
				"icon": "media/stop.svg"
			},
			{
				"command": "processing.sketch.open",
				"title": "Open a Processing Sketch"
			},
			{
				"command": "processing.sketch.new",
				"title": "Create a new Processing Sketch",
				"icon": "$(new-file)"
			},
			{
				"command": "processing.sketch.export",
				"title": "Export the Processing Sketch"
			},
			{
				"command": "processing.cli.download",
				"title": "Download ProcessingCLI"
			},
			{
				"command": "processing.sketch.preview",
				"title": "Preview the Processing Sketch",
				"icon": "$(open-preview)"
			}
		],
		"keybindings": [
			{
				"command": "processing.sketch.run",
				"key": "ctrl+r",
				"when": "editorTextFocus && (editorLangId == Processing || editorLangId == java)",
				"mac": "cmd+r"
			}
		],
		"menus": {
			"explorer/context": [
				{
					"command": "processing.sketch.run",
					"when": "resourceExtname == .pde",
					"group": "navigation"
				}
			],
			"editor/title": [
				{
					"command": "processing.sketch.preview",
					"when": "editorLangId == Processing || editorLangId == java",
					"group": "navigation"
				},
				{
					"command": "processing.sketch.run",
					"when": "!processing.sketch.running && (editorLangId == Processing || editorLangId == java)",
					"group": "navigation"
				},
				{
					"command": "processing.sketch.restart",
					"when": "processing.sketch.running && (editorLangId == Processing || editorLangId == java)",
					"group": "navigation"
				},
				{
					"command": "processing.sketch.stop",
					"when": "editorLangId == Processing || editorLangId == java",
					"group": "navigation"
				}
			],
			"view/title": [
				{
					"command": "processing.sketch.new",
					"when": "view == processingSidebarSketchbookView",
					"group": "navigation"
				}
			],
			"terminal/context": [
				{
					"command": "processing.sketch.run",
					"group": "navigation"
				},
				{
					"command": "processing.sketch.stop",
					"group": "navigation"
				}
			]
		},
		"configuration": {
			"type": "object",
			"title": "Processing",
			"properties": {
				"processing.version": {
					"scope": "machine",
					"type": "string",
					"default": "latest",
					"description": "The version of the Processing to use. The latest version is used by default."
				},
				"processing.cliPath": {
					"scope": "machine",
					"type": "string",
					"default": "",
					"description": "Absolute path to your own ProcessingCLI executable. Leave empty to use the one the extension downloads."
				},
				"processing.autosave": {
					"scope": "window",
					"type": "boolean",
					"default": true,
					"description": "Automatically save the sketch before running it."
				},
				"processing.newWindow": {
					"scope": "window",
					"type": "boolean",
					"default": true,
					"description": "Open sketches in a new window. If disabled, the current window will be reused."
				}
			}
		},
		"viewsContainers": {
			"activitybar": [
				{
					"id": "processingSidebar",
					"title": "Processing",
					"icon": "media/processing-flat-color.svg"
				}
			],
			"panel": [
				{
					"id": "processingConsole",
					"title": "Processing Console",
					"icon": "media/processing-flat-color.svg"
				}
			]
		},
		"views": {
			"processingConsole": [
				{
					"type": "webview",
					"id": "processingConsoleView",
					"name": "Console",
					"icon": "media/processing-flat-color.svg"
				}
			],
			"processingSidebar": [
				{
					"type": "tree",
					"id": "processingSidebarSketchbookView",
					"name": "Sketchbook",
					"icon": "media/processing-flat-color.svg"
				},
				{
					"type": "tree",
					"id": "processingSidebarExamplesView",
					"name": "Examples",
					"icon": "media/processing-flat-color.svg"
				}
			]
		},
		"languages": [
			{
				"id": "Processing",
				"extensions": [
					".pde"
				],
				"icon": {
					"light": "media/processing-icon.svg",
					"dark": "media/processing-icon.svg"
				},
				"configuration": "./syntaxes/processing-language.json"
			}
		],
		"grammars": [
			{
				"language": "Processing",
				"scopeName": "source.pde",
				"path": "./syntaxes/processing.tmGrammar.json"
			}
		]
	},
	"scripts": {
		"vscode:prepublish": "npm run compile && npm run bundle",
		"compile": "tsc -b",
		"bundle": "esbuild client/src/extension.ts --bundle --outfile=client/out/extension.js --external:vscode --format=cjs --platform=node --target=node16 --minify",
		"watch": "tsc -b -w",
		"lint": "eslint",
		"postinstall": "cd client && npm install && cd .."
	},
	"devDependencies": {
		"@eslint/js": "^9.13.0",
		"@stylistic/eslint-plugin": "^2.9.0",
		"@types/mocha": "^10.0.6",
		"@types/node": "^20",
		"esbuild": "0.25.10",
		"eslint": "^9.13.0",
		"mocha": "^10.3.0",
		"typescript": "^5.8.2",
		"typescript-eslint": "^8.26.0"
	},
	"dependencies": {
		"tree-kill": "^1.2.2"
	}
}
